<RCC>
    <!-- 所有资源编译进可执行程序，部署后无需依赖源码目录中的图片和字体。 -->
    <qresource prefix="/assets">
        <!-- 管理端车辆透视图与充电动效素材。 -->
        <file alias="admin-xray-car.png">../src/charging_core/static/assets/admin-xray-car.png</file>
        <file alias="charging-plasma.png">../src/charging_core/static/assets/charging-plasma.png</file>
        <!-- 用户端车辆展示素材。 -->
        <file alias="ev-photo.png">../src/charging_core/static/assets/ev-photo.png</file>
        <file alias="ev-top-photo.png">../src/charging_core/static/assets/ev-top-photo.png</file>
        <!-- 自绘地图使用的深圳道路几何与区域轮廓。 -->
        <file alias="shenzhen-roads.geojson">../src/charging_core/static/assets/shenzhen-roads.geojson</file>
        <file alias="shenzhen-region.svg">../src/charging_core/static/assets/shenzhen-region.svg</file>
        <!-- 内置中文字体保证不同 Windows 机器上的排版尽量一致。 -->
        <file alias="noto-sans-sc.ttf">assets/noto-sans-sc.ttf</file>
    </qresource>
</RCC>
